{
  "hosting": {
    "site": "myhatchai",
    "public": "dist/myhatchai/site",
    "ignore": ["**/.*", "**/node_modules/**"],
    "redirects": [
      { "regex": "^[/\\\\]$", "destination": "/online-login.html", "type": 302 },
      { "regex": "^[/\\\\]online$", "destination": "/online-login.html", "type": 302 },
      { "regex": "^[/\\\\]dashboard\\.html$", "destination": "/online-login.html", "type": 302 }
    ],
    "rewrites": [],
    "headers": [
      {
        "regex": ".*",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      {
        "regex": "^[/\\\\]online-login\\.html$",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self'; connect-src 'self' https://dihufafcztqjuudjeqdm.supabase.co https://hatchai.kurtzidrickguno-robles.workers.dev; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": { "host": "127.0.0.1", "port": 5005 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
